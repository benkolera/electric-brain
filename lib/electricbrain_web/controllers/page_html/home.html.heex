<Layouts.app flash={@flash} current_user={@current_user}>
  <section class="hero py-16 sm:py-24">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <img
          src={~p"/images/brain-logo.png"}
          alt="Electric Brain"
          class="mx-auto mb-6 size-48 rounded-3xl drop-shadow-[0_0_36px_var(--color-primary)]"
        />
        <h1 class="text-5xl sm:text-6xl font-extrabold tracking-tight text-primary drop-shadow-[0_0_18px_var(--color-primary)]">
          Electric Brain
        </h1>
        <p class="py-6 text-lg text-neutral-content/80">
          A neon-charged notebook for thoughts, tasks, and whiteboard sketches.
          Markdown notes, touch-friendly diagrams, and todos that keep up.
        </p>
        <%= if @current_user do %>
          <div class="flex gap-3 justify-center">
            <.link navigate={~p"/notes"} class="btn btn-primary">
              Open notes <span aria-hidden="true">&rarr;</span>
            </.link>
            <.link navigate={~p"/todos"} class="btn btn-outline btn-secondary">
              View todos
            </.link>
          </div>
        <% else %>
          <div class="flex gap-3 justify-center">
            <.link navigate={~p"/register"} class="btn btn-primary">
              Get started
            </.link>
            <.link navigate={~p"/sign-in"} class="btn btn-outline btn-secondary">
              Sign in
            </.link>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="grid sm:grid-cols-3 gap-4">
    <div class="card bg-base-200 border border-base-300">
      <div class="card-body">
        <h3 class="card-title text-primary">
          <.icon name="hero-document-text" class="size-5" /> Markdown notes
        </h3>
        <p class="text-sm text-neutral-content/70">
          Capture thoughts in plain Markdown. Rendered with syntax highlighting via mdex.
        </p>
      </div>
    </div>
    <div class="card bg-base-200 border border-base-300">
      <div class="card-body">
        <h3 class="card-title text-primary">
          <.icon name="hero-pencil" class="size-5" /> Touch diagrams
        </h3>
        <p class="text-sm text-neutral-content/70">
          Sketch diagrams with your finger or stylus. Saved as vector strokes alongside the note.
        </p>
      </div>
    </div>
    <div class="card bg-base-200 border border-base-300">
      <div class="card-body">
        <h3 class="card-title text-secondary">
          <.icon name="hero-check-circle" class="size-5" /> Todos
        </h3>
        <p class="text-sm text-neutral-content/70">
          Quick-capture tasks with priorities and due dates.
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
