<!DOCTYPE html>
<html lang="en-GB" data-theme={ElectricbrainWeb.Layouts.theme_attr(assigns[:current_user])}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="theme-color" content="#e8a07c" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Trellis" />
    <link rel="icon" type="image/png" href={~p"/favicon.png"} />
    <link rel="apple-touch-icon" href={~p"/images/trellis-logo-256.png"} />
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <.live_title default="Trellis" suffix=" · Trellis">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script type="module" phx-track-static src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-base-100 text-base-content">
    {@inner_content}
  </body>
</html>
